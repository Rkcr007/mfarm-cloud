node_modules/

# Ruflo / claude-flow runtime state. Agent coordination scratch and a local vector DB —
# machine-specific, regenerated on demand, and noisy in a diff. Never a build input.
.claude-flow/
.swarm/
ruvector.db
agentdb.rvf
agentdb.rvf.lock

# Production secrets and backup artifacts (deploy/). .env.example is the tracked template.
deploy/.env
deploy/backups/

# Production secret material (deploy/secrets/). Never committed.
deploy/secrets/

# deploy/farm-up.sh state. Holds the minted tenant API key so a re-run does not mint another —
# a live credential, and never a build input.
deploy/.state/

# Session scratch: worktrees, checkpoints, local agent config. Never part of a release.
.claude/


# macOS writes one of these into any directory somebody opens in Finder. It is not the project's,
# it changes on its own, and left untracked it sits in every `git status` until someone adds it by
# accident.
.DS_Store

# The npm publish build (apps/cli). Generated by `apps/cli/build.mjs` from the TypeScript beside it
# and regenerated by `prepack` on every publish, so a committed copy could only ever be a stale one
# that disagrees with the source it claims to be.
apps/cli/dist/

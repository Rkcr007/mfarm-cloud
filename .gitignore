node_modules/

# Ruflo / claude-flow runtime state. Agent coordination scratch and a local vector DB —
# machine-specific, regenerated on demand, and noisy in a diff. Never a build input.
.claude-flow/
.swarm/
ruvector.db
agentdb.rvf
agentdb.rvf.lock

# Production secrets and backup artifacts (deploy/). .env.example is the tracked template.
deploy/.env
deploy/backups/

# Production secret material (deploy/secrets/). Never committed.
deploy/secrets/

# deploy/farm-up.sh state. Holds the minted tenant API key so a re-run does not mint another —
# a live credential, and never a build input.
deploy/.state/

# Session scratch: worktrees, checkpoints, local agent config. Never part of a release.
.claude/

# Built by `npm run build --workspace apps/console`, and by the console stage in
# apps/api/Dockerfile. Never committed: a checked-in build artifact goes stale silently the first
# time somebody edits a component and does not rebuild.
apps/api/public/app/

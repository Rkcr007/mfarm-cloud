{
  // Type CHECKING only — `noEmit` is the point. Node ≥ 22.6 strips types at runtime and never looks
  // at them, so without this nothing in the repo is ever checked: a wrong field name, a missing
  // await, a null that cannot be null all run happily until the branch that touches them does.
  //
  // `npm run typecheck`. No build step is added by this file and none should be.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Imports carry the `.ts` extension because that is what Node's type stripping resolves.
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Matches what strip-only type removal can actually handle: anything that would need code
    // GENERATED for it (enums, namespaces, `import x =`, parameter properties) is rejected here
    // rather than at 3am by a Node parser error on a machine with no build step to fix it.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "types": ["node"]
  },
  "include": ["apps/**/*.ts", "workers/**/*.ts", "packages/**/*.ts"],

  // `apps/console` is EXCLUDED, and it has to be: it is the only browser target in the repo, so it
  // needs `lib: ["DOM"]` and this file deliberately has `lib: ["es2023"]` for Node. Compiled here
  // it fails on `window`, `RTCIceServer` and `HTMLVideoElement.srcObject` — all of which are real
  // and correct in a browser.
  //
  // It is not unchecked. `apps/console/tsconfig.json` has the right options and its own `build`
  // script runs `tsc --noEmit` before Vite; CI runs that build, and its step comment already says
  // it is the only thing that typechecks the console.
  //
  // This became load-bearing on 2026-09-02. Until then the console was `.tsx` plus a
  // `vite.config.ts` that happens to touch no DOM API, so the glob above matched almost nothing and
  // the gap was invisible. The live-view port added plain `.ts` modules and it stopped being.
  "exclude": ["**/node_modules", "apps/console"]
}

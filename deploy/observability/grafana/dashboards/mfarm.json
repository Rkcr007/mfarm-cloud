{
  "uid": "mfarm-farm",
  "title": "MFARM — farm health",
  "description": "The one page that answers 'is the farm healthy'. Top row is state you act on immediately; below it, the same facts over time so you can tell a spike from a trend. Device-state colours are pinned per state rather than assigned by series order — with an automatic palette, a state disappearing repaints every state after it, and the colour you learned to read as READY becomes CLEANING.",
  "tags": ["mfarm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Right now",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Devices ready",
      "description": "Allocatable this second. Zero is normal on a busy farm — it is only alarming next to 'in session' also being zero.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(mfarm_devices{state=\"READY\"})" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "In session",
      "description": "Devices a tenant is actively driving.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(mfarm_devices{state=~\"RESERVED|SESSION_ACTIVE\"})" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Unusable",
      "description": "Offline, quarantined or evicted. At two devices, one is half the farm — this tile is red at 1 on purpose.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(mfarm_devices{state=~\"OFFLINE|QUARANTINED|EVICTED\"})" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Waiting for a device",
      "description": "Sessions in QUEUED. Queueing is the designed answer to contention, not a fault — the wait beside it is the number that matters.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(mfarm_sessions{state=\"QUEUED\"})" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Longest wait",
      "description": "How long the oldest queued session has been waiting. Alerts at 15 minutes.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "refId": "A", "expr": "mfarm_session_queue_oldest_seconds" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 900 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Longest restore",
      "description": "The reset-failure signal. A snapshot restore takes seconds; a device left in CLEANING has failed and will never return to the pool on its own.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "refId": "A", "expr": "mfarm_device_cleaning_age_seconds_max" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "type": "row",
      "title": "Fleet",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Devices by state",
      "description": "Stacked, so the total is the fleet size and a device leaving the fleet is visible as the stack getting shorter rather than as one series dipping.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "sum by (state) (mfarm_devices)", "legendFormat": "{{state}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 35,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "axisSoftMax": 2
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "READY" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "SESSION_ACTIVE" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "RESERVED" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "light-blue" } }] },
          { "matcher": { "id": "byName", "options": "BOOTING" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] },
          { "matcher": { "id": "byName", "options": "CLEANING" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "OFFLINE" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }] },
          { "matcher": { "id": "byName", "options": "QUARANTINED" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "EVICTED" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-red" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Waiting and restoring",
      "description": "Both in seconds, so they share one axis honestly. A restore that climbs past a few minutes is a failed reset; a wait that climbs is contention.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "mfarm_session_queue_oldest_seconds", "legendFormat": "oldest queued session" },
        { "refId": "B", "expr": "mfarm_device_cleaning_age_seconds_max", "legendFormat": "longest restore" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "oldest queued session" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "longest restore" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Host heartbeat age",
      "description": "Seconds since each host last checked in. The agent beats every 10s, so a line that keeps climbing is a host that has stopped — and its devices' states are now fiction.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - mfarm_host_last_heartbeat_timestamp_seconds",
          "legendFormat": "{{hostname}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Reaper",
      "description": "The only signal the reaper has. It has no caller, so a sweep that stops happening is otherwise invisible until a crashed client's device is still held hours later.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "rate(mfarm_reaper_runs_total[5m]) * 60", "legendFormat": "sweeps/min" },
        { "refId": "B", "expr": "rate(mfarm_reaper_sessions_expired_total[5m]) * 60", "legendFormat": "sessions expired/min" },
        { "refId": "C", "expr": "rate(mfarm_reaper_sessions_promoted_total[5m]) * 60", "legendFormat": "queued promoted/min" },
        { "refId": "D", "expr": "rate(mfarm_reaper_failures_total[5m]) * 60", "legendFormat": "failures/min" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "failures/min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "sweeps/min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Postgres pool",
      "description": "`waiting` above zero is the shape every pool-exhaustion incident has before it becomes a timeout. The owner pool has five connections and the reaper shares them.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "mfarm_pg_pool_connections",
          "legendFormat": "{{pool}} {{state}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*waiting" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },

    {
      "type": "row",
      "title": "Control plane",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "description": "By route pattern, never by URL — a URL label would put a session uuid in the series name and the cardinality would grow with traffic forever.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(mfarm_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": "2.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byRegexp", "options": "4.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Request latency",
      "description": "Quantiles over the whole API. Session creation is the one that matters: it takes a row lock on the org and an allocator transaction, so it is where contention shows up first.",
      "datasource": { "type": "prometheus", "uid": "mfarm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(mfarm_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mfarm_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mfarm_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}

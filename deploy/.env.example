# Copy to deploy/.env and fill in. deploy/.env is gitignored and must stay that way.
#
# Generate each password with something you did not think of yourself:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40

# ---------------------------------------------------------------- database
# The OWNER role. Migrations and fleet operations run as this; request handling must NOT.
POSTGRES_USER=mfarm
POSTGRES_PASSWORD=
POSTGRES_DB=mfarm

# Loopback-only port on the host. Reachability comes from Tailscale, not from publishing this.
POSTGRES_PORT=5432

# ---------------------------------------------------------------- backups
# 21600 = 6h. This interval IS your RPO: with no WAL archiving, a total loss costs you up to one
# interval of farm history. Shorten it if that matters more than the disk.
BACKUP_INTERVAL_SECONDS=21600
# 28 backups at 6h is a week of history.
BACKUP_KEEP=28
# Where backups land on the host. Put this on a different disk from the database if you have one —
# a backup sharing a disk with its source survives a bad migration, not a dead drive.
BACKUP_HOST_DIR=./backups

# ---------------------------------------------------------------- application
# The APP role — non-superuser, no BYPASSRLS, owns nothing. This is the connection every request
# handler uses, and the reason tenant isolation is real rather than decorative.
#
# Only the PASSWORD lives here; the compose file builds the URL, so the in-container hostname
# (`postgres`) cannot drift from what you would type on the host (`127.0.0.1`).
#
# migrations/001_init.sql creates mfarm_app with a committed local-dev password. Set a real one and
# make the database agree:
#   docker exec -i mfarm-postgres-1 psql -U mfarm -d mfarm \
#     -c "ALTER ROLE mfarm_app WITH PASSWORD '<the value below>'"
# config.ts refuses to boot in production if it sees the committed default, so a farm that skipped
# this does not start.
APP_DB_PASSWORD=

# Optional tuning.
REAPER_INTERVAL_MS=30000
LOG_LEVEL=info
API_PORT=3000
MFARM_VERSION=latest

# ---------------------------------------------------------------- secrets (FILES, not variables)
#
# The signing key is a multi-line PEM and compose .env files cannot hold multi-line values, so these
# three arrive as Docker secrets read from deploy/secrets/. They never appear in this file, in
# `docker inspect`, or in `docker compose config`.
#
#   mkdir -p deploy/secrets && chmod 700 deploy/secrets
#   openssl genpkey -algorithm ed25519 -out deploy/secrets/session_signing_key.pem
#   openssl pkey -in deploy/secrets/session_signing_key.pem -pubout \
#     -out deploy/secrets/session_public_key.pem
#   openssl rand -base64 32 | tr -d '/+=' > deploy/secrets/worker_registration_token
#   chmod 600 deploy/secrets/*
#
# The private half never leaves the control plane — workers receive only the public key, at
# registration, so a compromised host can verify session tokens but can never mint one.

# ---------------------------------------------------------------- running migrations from the host
#
# The compose services build their own URLs against the `postgres` service name. To run migrations
# from your shell instead, use the loopback form:
#   DATABASE_URL=postgres://mfarm:$POSTGRES_PASSWORD@127.0.0.1:5432/mfarm npm --prefix apps/api run migrate

# Copy to deploy/.env and fill in. deploy/.env is gitignored and must stay that way.
#
# Generate each password with something you did not think of yourself:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40

# ---------------------------------------------------------------- database
# The OWNER role. Migrations and fleet operations run as this; request handling must NOT.
POSTGRES_USER=mfarm
POSTGRES_PASSWORD=
POSTGRES_DB=mfarm

# Loopback-only port on the host. Reachability comes from Tailscale, not from publishing this.
POSTGRES_PORT=5432

# ---------------------------------------------------------------- backups
# 21600 = 6h. This interval IS your RPO: with no WAL archiving, a total loss costs you up to one
# interval of farm history. Shorten it if that matters more than the disk.
BACKUP_INTERVAL_SECONDS=21600
# 28 backups at 6h is a week of history.
BACKUP_KEEP=28
# Where backups land on the host. Put this on a different disk from the database if you have one —
# a backup sharing a disk with its source survives a bad migration, not a dead drive.
BACKUP_HOST_DIR=./backups

# ---------------------------------------------------------------- application
# The APP role — non-superuser, no BYPASSRLS, owns nothing. This is the connection every request
# handler uses, and the reason tenant isolation is real rather than decorative.
#
# It must NOT equal DATABASE_URL. config.ts exits 78 in production if the two converge, because
# request handling that runs as the owner bypasses row-level security while every policy still
# reads as enabled.
#
# The password below has to match what you set with:
#   ALTER ROLE mfarm_app WITH PASSWORD '...';
# migrations/001_init.sql creates mfarm_app with a committed local-dev password. Rotate it before
# the farm serves anything; config.ts refuses to boot in production if it sees the dev default.
APP_DATABASE_URL=postgres://mfarm_app:CHANGE_ME@127.0.0.1:5432/mfarm
DATABASE_URL=postgres://mfarm:CHANGE_ME@127.0.0.1:5432/mfarm

# ---------------------------------------------------------------- signing key
# Ed25519 keypair for session tokens. Workers get the public half at registration and verify
# offline; the private half never leaves the control plane.
#   openssl genpkey -algorithm ed25519 -out session.key
#   openssl pkey -in session.key -pubout -out session.pub
SESSION_SIGNING_KEY=
SESSION_PUBLIC_KEY=

# Shared secret a new worker presents once, to obtain its own credential.
WORKER_REGISTRATION_TOKEN=

NODE_ENV=production

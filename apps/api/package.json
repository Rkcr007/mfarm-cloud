{
  "name": "@mfarm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "db:up": "docker compose up -d && node scripts/wait-for-pg.mjs",
    "db:down": "docker compose down -v",
    "migrate": "node scripts/migrate.mjs",
    "test": "node --test --test-concurrency=1 --experimental-strip-types test/*.test.ts",
    "verify": "npm run db:up && npm run migrate && npm test"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.0",
    "pg": "^8.13.1",
    "@mfarm/protocol": "*",
    "ws": "^8.18.0"
  },
  "exports": {
    "./config": "./src/config.ts",
    "./server": "./src/http/server.ts",
    "./db": "./src/db.ts",
    "./auth": "./src/auth.ts",
    "./tokens": "./src/tokens.ts"
  }
}
